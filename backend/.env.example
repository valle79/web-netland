# --- General ---
APP_NAME=NETLAND Corporación Inmobiliaria
ENVIRONMENT=development
DEBUG=true

# --- Database (Neon PostgreSQL) ---
# Ejemplo: postgresql+psycopg://user:password@ep-xxxx-xx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=netland

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Seed (primer usuario administrador) ---
SEED_ADMIN_EMAIL=admin@netlandcorp.com
SEED_ADMIN_PASSWORD=AdminNetland2026
SEED_ADMIN_NAME=Administrador Netland

# --- Contacto principal ---
COMPANY_WHATSAPP=51985928062
COMPANY_PHONE=985928062

# Plan Import Configuration
MAX_PLAN_PDF_SIZE_MB=30
PLAN_OCR_DPI=300
PLAN_OCR_LANG=spa+eng
PLAN_CONFIDENCE_THRESHOLD=0.60